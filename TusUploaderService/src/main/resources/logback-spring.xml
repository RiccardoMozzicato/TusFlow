<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Abilita %clr e conversioni Spring -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Palette colori personalizzata -->
    <property name="LOG_DATE" value="%clr(%d{HH:mm:ss.SSS}){faint}"/>
    <property name="LOG_THREAD" value="%clr([%thread]){magenta}"/>
    <property name="LOG_LEVEL" value="%highlight(%-5level){FATAL=red blink, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan, TRACE=blue}"/>
    <property name="LOG_LOGGER" value="%clr(%logger{30}){cyan}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <!-- No threshold here: the console honors the active profile's logger
             levels, so the dev profile (root=DEBUG) prints DEBUG to the console. -->
        <encoder>
            <pattern>
                ${LOG_DATE} ${LOG_THREAD} ${LOG_LEVEL} ${LOG_LOGGER} %clr([%mdc{traceId:-} %mdc{spanId:-}]){faint}
                --> %msg%n%ex{full}
            </pattern>
        </encoder>
    </appender>

    <!-- Loki appender (LGTM stack) -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="TusUploaderService"/>
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <!-- Ship only INFO+ to Loki to stay under its ingestion rate limit. The
             console already filters to INFO, so DEBUG was being sent to Loki only. -->
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <http>
            <url>http://localhost:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>application=${appName},host=${HOSTNAME},level=%level</pattern>
            </label>
            <!-- JSON line body so Loki/Grafana parse fields (incl. mdc_traceId / mdc_spanId from
                 MDC) instead of regex-scraping free text. JsonLayout ships with loki4j 1.5.2. -->
            <message class="com.github.loki4j.logback.JsonLayout"/>
        </format>
    </appender>

    <springProfile name="dev">
        <!-- Only our own code logs at DEBUG; framework/library noise stays at INFO. -->
        <logger name="g11.tusuploaderservice" level="DEBUG"/>

        <root level="INFO">
            <appender-ref ref="LOKI"/>
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>


    <springProfile name="prod">
        <!-- Our own code logs at INFO; framework/library noise only at WARN+. -->
        <logger name="g11.tusuploaderservice" level="INFO"/>

        <root level="WARN">
            <appender-ref ref="LOKI"/>
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!dev &amp; !prod">
        <!-- Default profile: keep framework/library noise at INFO but let our own
             code DEBUG logs through. -->
        <logger name="g11.tusuploaderservice" level="DEBUG"/>

        <root level="INFO">
            <appender-ref ref="LOKI"/>
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>