<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <property name="LOG_DATE" value="%clr(%d{HH:mm:ss.SSS}){faint}"/>
    <property name="LOG_THREAD" value="%clr([%thread]){magenta}"/>
    <property name="LOG_LEVEL" value="%highlight(%-5level){FATAL=red blink, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan, TRACE=blue}"/>
    <property name="LOG_LOGGER" value="%clr(%logger{30}){cyan}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>
                ${LOG_DATE} ${LOG_THREAD} ${LOG_LEVEL} ${LOG_LOGGER}
                --> %msg%n%ex{full}
            </pattern>
        </encoder>
    </appender>

    <!-- Loki appender (LGTM stack) -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="AIProcessingService"/>
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://localhost:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>application=${appName},host=${HOSTNAME},level=%level</pattern>
            </label>
            <message>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - traceId=%mdc{traceId:-} spanId=%mdc{spanId:-} - %msg%n</pattern>
            </message>
        </format>
    </appender>

    <logger name="g11.aiprocessingservice" level="DEBUG"/>
    <logger name="org.springframework" level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>

</configuration>

