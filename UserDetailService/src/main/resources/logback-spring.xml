<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Abilita %clr e conversioni Spring -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Palette colori personalizzata -->
    <property name="LOG_DATE" value="%clr(%d{HH:mm:ss.SSS}){faint}"/>
    <property name="LOG_THREAD" value="%clr([%thread]){magenta}"/>
    <property name="LOG_LEVEL" value="%highlight(%-5level){FATAL=red blink, ERROR=red, WARN=yellow, INFO=green, DEBUG=cyan, TRACE=blue}"/>
    <property name="LOG_LOGGER" value="%clr(%logger{30}){cyan}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>INFO</level>
        </filter>
        <encoder>
            <pattern>
                ${LOG_DATE} ${LOG_THREAD} ${LOG_LEVEL} ${LOG_LOGGER} %clr([%mdc{traceId:-} %mdc{spanId:-}]){faint}
                --> %msg%n%ex{full}
            </pattern>
        </encoder>
    </appender>

    <!-- Loki appender (LGTM stack) -->
    <springProperty scope="context" name="appName" source="spring.application.name" defaultValue="UserDetailService"/>
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://localhost:3100/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>application=${appName},host=${HOSTNAME},level=%level</pattern>
            </label>
            <message>
                <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - traceId=%mdc{traceId:-} spanId=%mdc{spanId:-} - %msg%n</pattern>
            </message>
        </format>
    </appender>


    <springProfile name="dev">
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
        <logger name="org.hibernate.type.descriptor.sql" level="WARN"/>

        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.springframework.web.servlet.DispatcherServlet" level="WARN"/>

        <logger name="org.apache.catalina" level="WARN"/>
        <logger name="org.apache.coyote" level="WARN"/>
        <logger name="org.apache.tomcat" level="WARN"/>

        <logger name="it.polito.wa2.userdetailservice" level="DEBUG"/>

        <root level="DEBUG">
            <appender-ref ref="LOKI"/>
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>


    <springProfile name="prod">
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>
        <logger name="org.hibernate.type.descriptor.sql" level="WARN"/>

        <logger name="org.springframework" level="INFO"/>
        <logger name="org.springframework.web" level="INFO"/>
        <logger name="org.springframework.security" level="INFO"/>
        <logger name="org.springframework.web.servlet.DispatcherServlet" level="WARN"/>

        <logger name="org.apache.catalina" level="WARN"/>
        <logger name="org.apache.coyote" level="WARN"/>
        <logger name="org.apache.tomcat" level="WARN"/>

        <logger name="it.polito.wa2.userdetailservice" level="INFO"/>

        <root level="INFO">
            <appender-ref ref="LOKI"/>
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!dev &amp; !prod">
        <root level="INFO">
            <appender-ref ref="LOKI"/>
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

</configuration>